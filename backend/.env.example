# Documentation only. Do not overwrite an existing .env with this file.
# Supply required app values through the deployment secret store.
MONGO_URL=
DB_NAME=
JWT_SECRET=
FRONTEND_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Phase 2: test-only backend creation; customer checkout is not switched.
RAZORPAY_ENABLED=false
RAZORPAY_CREATE_ORDERS_ENABLED=false
RAZORPAY_ENV=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CONNECT_TIMEOUT_SECONDS=5
RAZORPAY_READ_TIMEOUT_SECONDS=15
STOCK_RESERVATION_MINUTES=10

# Preserve existing Cashfree deployment values for historical orders.
# These disabled defaults are for NEW configuration, not a cutover instruction.
CASHFREE_ENABLED=false
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_RETURN_URL=
CASHFREE_WEBHOOK_URL=
CASHFREE_ORDER_EXPIRY_MINUTES=30

# Keep integrations inactive in newly configured local/test environments.
SHIPROCKET_ENABLED=false
EMAIL_ENABLED=false
TWILIO_WHATSAPP_ENABLED=false
FEEDBACK_SCHEDULER_ENABLED=false

# Keep false until the full Phase 3 recovery worker is validated.
RAZORPAY_PROCESSING_ENABLED=false

# Recovery must run before enabling new Razorpay orders.
RAZORPAY_WORKER_ENABLED=false
RAZORPAY_NOTIFICATIONS_ENABLED=false

# Test-only full cancellation refunds; enable after configuring refund webhooks.
RAZORPAY_REFUNDS_ENABLED=false

# Notification worker: these must also not be overridden to false in the startup command.
# RAZORPAY_WORKER_ENABLED=true
# RAZORPAY_NOTIFICATIONS_ENABLED=true
# EMAIL_ENABLED=true
# TWILIO_WHATSAPP_ENABLED=true
# Approved WhatsApp templates; variables: 1=name, 2=short order ID, 3=amount in INR.
TWILIO_WHATSAPP_ORDER_CANCELLED_CONTENT_SID=
TWILIO_WHATSAPP_REFUND_COMPLETED_CONTENT_SID=

# Keep false until production acceptance checks are complete.
RAZORPAY_LIVE_ENABLED=false
